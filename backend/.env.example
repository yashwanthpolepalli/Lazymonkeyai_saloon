# Database Configuration (PostgreSQL)
DB_USER=postgres
DB_PASSWORD=your_password
DB_HOST=localhost
DB_NAME=salon
DB_PORT=5432
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/salon

# App Configuration
APP_NAME=SaloonBusinessOS
APP_ENV=development
PORT=8000
HOST=0.0.0.0
DEBUG=True

# Security
SECRET_KEY=your_secret_jwt_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174,*
